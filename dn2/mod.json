{
 "id": "digihealth",
 "version": "1.3",
 "title": "digihealth",
 "category": "Diagnostics",
 "author": "irpina",
 "license": "GPL-2.0-or-later",
 "description": "Digitone II OS 1.12: heap diagnostics and SYSTEM INFO, bounded remote buttons and encoder turns, and consistent screen readback. CPU/DSP load and FAST AUDIO are not available on this port.",
 "device": "digitone-mk2",
 "os": "1.12",
 "sources": [
  "../sysinfo.s",
  "../remote_keys.c",
  "../remote_keys.s",
  "io.c"
 ],
 "defsym": {
  "DN2": 1,
  "RK_KEYS": 1
 },
 "cflags": [
  "-DRK_PRODUCT=3",
  "-DRK_OS_MINOR=12"
 ],
 "name_string": "digihealth",
 "subscribe": [
  {
   "event": "ev_settings",
   "fn": "si_settings",
   "order": 10
  },
  {
   "event": "ev_settings",
   "fn": "rk_settings",
   "order": 20
  },
  {
   "event": "ev_tick",
   "fn": "si_tick",
   "order": 50
  },
  {
   "event": "ev_tick",
   "fn": "rk_tick",
   "order": 60
  },
  {
   "event": "ev_draw",
   "fn": "si_draw",
   "order": 50
  },
  {
   "event": "ev_draw",
   "fn": "dn2_frame",
   "order": 100
  },
  {
   "event": "ev_sysex",
   "fn": "dn2_sysex",
   "order": 50
  },
  {
   "event": "ev_tick",
   "fn": "dn2_tick",
   "order": 70
  }
 ],
 "weak": [
  "r_on",
  "r_fault"
 ],
 "requires": [
  "core"
 ],
 "resources": {
  "core": "0.3",
  "names": [
   "settings:SYSTEM INFO",
   "settings:REMOTE KEYS",
   "sysex:0x7d"
  ]
 }
}
